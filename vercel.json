{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/queue(\\.html)?",
      "dest": "/queue.html",
      "headers": { "content-type": "text/html; charset=utf-8" }
    },
    {
      "src": "/(casheir|cashier|Casheir)(\\.html)?",
      "dest": "/Casheir.html",
      "headers": { "content-type": "text/html; charset=utf-8" }
    },
    {
      "src": "/manage(\\.html)?",
      "dest": "/manage.html",
      "headers": { "content-type": "text/html; charset=utf-8" }
    },
    {
      "src": "/(index(\\.html)?)?",
      "dest": "/index.html",
      "headers": { "content-type": "text/html; charset=utf-8" }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
