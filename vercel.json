{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/casheir",
      "dest": "/Casheir.html"
    },
    {
      "src": "/cashier",
      "dest": "/Casheir.html"
    },
    {
      "src": "/queue",
      "dest": "/queue.html"
    },
    {
      "src": "/manage",
      "dest": "/manage.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
