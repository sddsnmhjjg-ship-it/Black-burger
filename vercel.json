{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/queue",
      "dest": "/queue.html"
    },
    {
      "src": "/casheir",
      "dest": "/Casheir.html"
    },
    {
      "src": "/cashier",
      "dest": "/cashier.html"
    },
    {
      "src": "/manage",
      "dest": "/manage.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
